# =============================================================================
# EletroSync — Variáveis de ambiente
# =============================================================================
# Copia este ficheiro para .env e preenche com os valores reais.
# O ficheiro .env NÃO deve ser commitado (já está no .gitignore).
# =============================================================================

# Porta onde o servidor Express escuta (Render injecta a sua própria PORT)
PORT=3000

# Supabase — projeto, obtido em Settings → API no dashboard do teu projeto
# https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Serper.dev — API Key para Google Shopping (free tier: 2500 créditos/mês)
# https://serper.dev/dashboard
SERPER_API_KEY=your-serper-api-key

# ScraperAPI — Opcional para contornar Cloudflare e obter preços reais das lojas (free tier: 5000 créditos grátis)
# https://www.scraperapi.com/
SCRAPERAPI_KEY=your-scraperapi-key

# Opcional: ambiente (production esconde stack traces nas respostas)
NODE_ENV=development
